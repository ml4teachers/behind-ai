# =============================================================================
# Beispiel-Konfiguration. Kopiere nach .env.local und fülle die Werte aus.
# .env.local ist gitignored und darf KEINE echten Schlüssel im Repo landen lassen.
# =============================================================================

# --- OpenAI (nur falls noch andere Seiten/Features OpenAI nutzen) ------------
OPENAI_API_KEY=

# --- Hugging Face (optional) -------------------------------------------------
HUGGINGFACE_API_KEY=


# A) LOKALE ENTWICKLUNG – Pfad zur Dienstkonto-JSON-Datei:
GOOGLE_APPLICATION_CREDENTIALS=/absoluter/pfad/zu/gcp-service-account.json

# B) DEPLOYMENT (Vercel etc.) – Dienstkonto-Credentials als Env-Variable,
#    KEINE Datei. JSON-Inhalt direkt ODER als Base64 (wird automatisch erkannt).
#    Base64 erzeugen:  base64 -i gcp-service-account.json | pbcopy
#    Dann in Vercel als Environment Variable einfügen.
#    (Wenn gesetzt, hat dieser Weg Vorrang vor GOOGLE_APPLICATION_CREDENTIALS.)
# GCP_SERVICE_ACCOUNT_KEY=

# --- Optional (beide Wege) ---------------------------------------------------
# Region (Default: us-central1; global/europe-west1 liefern teils 403)
# GCP_LOCATION=us-central1
# Projekt-ID (sonst aus den Credentials gelesen)
# GCP_PROJECT_ID=
# Primärmodell überschreiben (Default: gemini-2.5-flash, dann -lite als Fallback)
# GEMINI_MODEL=gemini-2.5-flash
